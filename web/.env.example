# Domain registered at onedollarstats.com (required with devmode for localhost)
NEXT_PUBLIC_ONEDOLLARSTATS_HOSTNAME=opensen-web.vercel.app

# Send local events to the dashboard (enable Dev Mode toggle there)
NEXT_PUBLIC_ONEDOLLARSTATS_DEVMODE=false

# Optional; default is https://collector.onedollarstats.com/events
# NEXT_PUBLIC_ONEDOLLARSTATS_COLLECTOR_URL=

# OpenSen Hono API (backend/). Local: run `npm run dev` in backend/ (often port 3000).
# Add the Next.js origin to backend CORS_ORIGINS (e.g. http://localhost:3001).
NEXT_PUBLIC_OPENSEN_API_URL=http://localhost:3000

# Managed Better Auth. Auth URL is on Neon Console → Project → Branch → Auth → Configuration.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
# openssl rand -base64 32 — at least 32 characters. Do not commit the real value.
# Required at build time (Next collects /api/auth/[...path]) and at runtime.
NEON_AUTH_COOKIE_SECRET=

# Sentry (browser + server). Same DSN value is fine in both. Browser events
# tunnel through https://opensen.taquangkhoi.com/monitoring in production.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Build-time source map upload. Do not commit the real token.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
