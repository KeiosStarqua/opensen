# Browser-visible values use the VITE_ prefix: Vite inlines them into client
# code at build time. Never put a secret in a VITE_ variable.

# Domain registered at onedollarstats.com (required with devmode for localhost)
VITE_ONEDOLLARSTATS_HOSTNAME=opensen-web.vercel.app

# Send local events to the dashboard (enable Dev Mode toggle there)
VITE_ONEDOLLARSTATS_DEVMODE=false

# Optional; default is https://collector.onedollarstats.com/events
# VITE_ONEDOLLARSTATS_COLLECTOR_URL=

# OpenSen Hono API (backend/). Optional override: production builds default to
# https://api.opensen.taquangkhoi.com, `vite dev` defaults to http://localhost:3000.
# Add the web origin to backend CORS_ORIGINS (e.g. http://localhost:3001).
# VITE_OPENSEN_API_URL=http://localhost:3000

# Managed Better Auth (server-only). Auth URL is on Neon Console → Project →
# Branch → Auth → Configuration.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
# openssl rand -base64 32 — at least 32 characters. Do not commit the real value.
# Read at runtime by the server; not needed for `npm run build`.
NEON_AUTH_COOKIE_SECRET=

# Sentry project do-quyen/opensen-web. Same DSN value is fine in both.
# Browser events tunnel through https://opensen.taquangkhoi.com/monitoring.
VITE_SENTRY_DSN=
SENTRY_DSN=
# Build-time source map upload. Do not commit the real token.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=do-quyen
SENTRY_PROJECT=opensen-web
