# Browser origins allowed for CORS (Flutter web / local tools). Comma-separated.
# Unset default: http://localhost:3000,https://opensen.taquangkhoi.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# AI provider: openrouter (add openai | anthropic | gemini later)
AI_PROVIDER=openrouter
# OpenRouter model id — swap freely without code changes
AI_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
# Optional OpenRouter attribution headers
# OPENROUTER_SITE_URL=https://opensen.app
OPENROUTER_APP_NAME=OpenSen

# Neon / Postgres runtime connection (pooled HTTP/WebSocket endpoint on Vercel).
# `neon link` writes this, plus DATABASE_URL_UNPOOLED, into .env.local.
# DATABASE_URL=postgresql://user:pass@host-pooler/db?sslmode=require

# Direct Neon connection (no pooler). db:migrate prefers this over DATABASE_URL
# when MIGRATION_DATABASE_URL is unset.
# DATABASE_URL_UNPOOLED=postgresql://user:pass@host/db?sslmode=require

# Optional direct connection override for DDL migrations.
# MIGRATION_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Neon Auth (Managed Better Auth) URL — same value as web's NEON_AUTH_BASE_URL.
# User-scoped routes (practice, export, chunk create/edit) require
# `Authorization: Bearer <session JWT>`; tokens are verified against
# <NEON_AUTH_BASE_URL>/.well-known/jwks.json. Unset: anonymous routes still work,
# requests that send a token get 503.
# NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth

# DIALOGUE_PERSISTENCE_MODE=disabled
# DIALOGUE_PERSISTENCE_MODE=internal
# DIALOGUE_PERSISTENCE_MODE=ephemeral

# Disposable integration-test database only — never production
# TEST_DATABASE_URL=postgresql://opensen:opensen@localhost:5433/opensen_test
